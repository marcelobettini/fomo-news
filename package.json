{
  "name": "fomo-news-ingestor",
  "version": "0.1.0",
  "private": true,
  "description": "Captura periódica de noticias locales de Tandil (componente ingestor).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test dist/tests/unit/*.test.js dist/tests/http/*.test.js dist/tests/notifier/*.test.js",
    "ingest": "node --env-file=.env dist/src/main.js",
    "serve": "node --env-file=.env.server dist/src/server.js",
    "notify": "node --env-file=.env.notifier dist/src/notifier.js",
    "predev:server": "tsc -p tsconfig.json",
    "dev:server": "node dist/src/devServer.js",
    "predev:notifier": "tsc -p tsconfig.json",
    "dev:notifier": "node dist/src/devNotifier.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.10.0",
    "mongodb": "^6.10.0",
    "nodemailer": "^9.0.3",
    "npm": "^10.9.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
