# Cadena de conexión de MongoDB de SOLO LECTURA (rol `read`), distinta de MONGODB_URI del
# ingestor. No versionar el valor real (research.md §4 de specs/002-public-news-endpoint/).
MONGODB_READONLY_URI=

# Zona horaria por NOMBRE DE REGIÓN IANA, nunca por offset numérico (Artículo VI). Mismo
# formato que TIMEZONE del ingestor. Ejemplo: America/Argentina/Buenos_Aires
TIMEZONE=

# Puerto de escucha del servidor HTTP.
PORT=

# Máximo de peticiones por IP dentro de RATE_LIMIT_WINDOW_MS (FR-010).
RATE_LIMIT_MAX_PER_IP=

# Ventana de tiempo del límite de tasa, en milisegundos.
RATE_LIMIT_WINDOW_MS=

# Vigencia, en milisegundos, de la caché en memoria del conjunto de noticias del día antes de
# refrescar contra MongoDB (research.md §3 de specs/002-public-news-endpoint/).
CACHE_TTL_MS=

# --- Feature 003: ciclo de vida de suscriptores (alta/confirmación/baja) ---

# Cadena de conexión de MongoDB con rol acotado a `subscribers`/`suppressions` únicamente
# (research.md §4 de specs/003-subscriber-lifecycle/), distinta de MONGODB_READONLY_URI y de
# MONGODB_URI. No versionar el valor real.
MONGODB_SUBSCRIBERS_URI=

# URL absoluta y pública del proceso HTTP, usada para construir los enlaces de confirmación y
# de baja embebidos en los mensajes de correo. Ejemplo: https://noticias.tandil.example
PUBLIC_BASE_URL=

# Clave de la API de Resend (research.md §1/§2 de specs/003-subscriber-lifecycle/). Secreto, no
# versionar.
EMAIL_PROVIDER_API_KEY=

# Dirección de correo remitente, verificada en el dominio propio de Resend (research.md §9).
EMAIL_SENDER_ADDRESS=

# Secreto de verificación de firma de los webhooks entrantes de Resend (esquema Svix,
# research.md §3). Secreto, no versionar.
EMAIL_WEBHOOK_SIGNING_SECRET=

# Secreto del HMAC usado para derivar el `_id` no reversible de `suppressions` (research.md §7).
# Distinto del secreto de firma de webhooks. Secreto, no versionar.
EMAIL_SUPPRESSION_HASH_SECRET=

# Vigencia, en milisegundos, del token de confirmación de alta antes de vencer (FR-003/FR-005).
CONFIRMATION_TOKEN_TTL_MS=

# Tiempo mínimo, en milisegundos, entre reenvíos del correo de confirmación para la misma
# dirección pendiente (research.md §6).
SIGNUP_RESEND_COOLDOWN_MS=

# Máximo de solicitudes de alta (POST /subscribers) por IP dentro de
# SIGNUP_RATE_LIMIT_WINDOW_MS (FR-016), independiente de RATE_LIMIT_MAX_PER_IP de GET /news.
SIGNUP_RATE_LIMIT_MAX_PER_IP=

# Ventana de tiempo, en milisegundos, del límite de tasa anterior.
SIGNUP_RATE_LIMIT_WINDOW_MS=
