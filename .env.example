# Cadena de conexión a MongoDB (Atlas). No versionar el valor real.
MONGODB_URI=

# URL del feed Atom de la fuente.
SOURCE_FEED_URL=

# Categoría objetivo a conservar (debe coincidir con la categoría declarada en el feed).
TARGET_CATEGORY=

# Zona horaria por NOMBRE DE REGIÓN IANA, nunca por offset numérico (Artículo VI).
# Ejemplo: America/Argentina/Buenos_Aires
TIMEZONE=

# Retención de noticias, en milisegundos, medida de forma rodante desde publishedAt.
# Debe cubrir el cruce entre el cierre de un día local y el comienzo del siguiente (FR-009).
NEWS_RETENTION_MS=

# Retención de la copia cruda de diagnóstico, en milisegundos. Corta e independiente de
# NEWS_RETENTION_MS (FR-020).
RAW_SNAPSHOT_RETENTION_MS=

# Umbral, en milisegundos, de ausencia prolongada de la categoría objetivo antes de alarmar
# (FR-014).
CATEGORY_SILENCE_THRESHOLD_MS=
