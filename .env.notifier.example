# Cadena de conexión de MongoDB acotada por rol: lectura de `news` y `subscribers`,
# lectura-escritura de `deliveries` y `locks` (research.md §10 de specs/004-send-email-news/).
# Distinta de MONGODB_URI, MONGODB_READONLY_URI y MONGODB_SUBSCRIBERS_URI. No versionar el
# valor real.
MONGODB_NOTIFIER_URI=

# Zona horaria por NOMBRE DE REGIÓN IANA, nunca por offset numérico (Artículo VI). Mismo
# formato que TIMEZONE del ingestor. Ejemplo: America/Argentina/Buenos_Aires
TIMEZONE=

# URL absoluta y pública del proceso HTTP de suscriptores, usada para construir el enlace de
# baja y el enlace a la consulta pública embebidos en cada mensaje. Mismo valor que
# PUBLIC_BASE_URL de .env.server.
PUBLIC_BASE_URL=

# Clave de la API de Resend (mismo proveedor que .env.server). Secreto, no versionar.
EMAIL_PROVIDER_API_KEY=

# Dirección de correo remitente, verificada en el dominio propio de Resend. Mismo valor que
# EMAIL_SENDER_ADDRESS de .env.server.
EMAIL_SENDER_ADDRESS=

# Secreto compartido con .env.server (mismo valor en ambos) para derivar de forma
# determinística el token de baja a partir del correo del suscriptor (research.md §8 de
# specs/004-send-email-news/). Secreto, no versionar.
UNSUBSCRIBE_TOKEN_SECRET=

# Inicio de la ventana horaria permitida para enviar, hora local, formato "HH:MM" (24 horas).
# Fuera de esta ventana no se envía nada (FR-005).
SEND_WINDOW_START_LOCAL=

# Fin de la ventana horaria permitida para enviar, hora local, formato "HH:MM" (24 horas).
# Se asume mayor o igual que SEND_WINDOW_START_LOCAL (research.md §5).
SEND_WINDOW_END_LOCAL=

# Vencimiento máximo de antigüedad, en milisegundos, para que una noticia siga siendo
# elegible de envío (FR-002). Medido desde publishedAt hasta el momento de la corrida.
MAX_PENDING_AGE_MS=

# Tope máximo de noticias incluidas en un mismo mensaje (FR-009). Lo que exceda el tope queda
# pendiente para una corrida siguiente si sigue vigente.
MAX_NEWS_PER_MESSAGE=

# Intervalo máximo esperado, en milisegundos, entre invocaciones sucesivas de este proceso
# (cadencia de cron). Se usa solo para la validación de coherencia con la retención de
# noticias al arrancar (research.md §6 de specs/004-send-email-news/); no dispara ningún envío
# por sí mismo.
MAX_SEND_INTERVAL_MS=

# Retención de noticias del ingestor, en milisegundos — mismo valor que NEWS_RETENTION_MS de
# .env. Duplicado acá únicamente para la validación de coherencia al arrancar: el proceso se
# niega a arrancar si NEWS_RETENTION_MS no es estrictamente mayor que
# MAX_SEND_INTERVAL_MS + MAX_PENDING_AGE_MS (research.md §6).
NEWS_RETENTION_MS=
